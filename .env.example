# 复制为 .env 并填写真实值。.env 已被 .gitignore 忽略，不会提交到仓库。
# 注意：本文件（.env.example）中不要填写真实密钥！

# ---- LLM 服务 ----
# vLLM 本地服务的 api key
LLM_API_KEY=sk-your-llm-key
# vLLM OpenAI 兼容服务地址
LLM_BASE_URL=http://127.0.0.1:8765/v1
# 模型本地路径与对外服务名
MODEL_PATH=/path/to/your/model
SERVED_MODEL_NAME=qwen3-vl-8b
# 使用的 GPU 卡号
CUDA_VISIBLE_DEVICES=1

# ---- GitHub 推送认证 ----
# 在 https://github.com/settings/tokens 创建 token，勾选 repo 权限
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=your-github-token
